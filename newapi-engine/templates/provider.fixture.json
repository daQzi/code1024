{
  "unixNow": 1805587200,
  "cases": [
    {
      "name": "converts supported non-streaming input",
      "hook": "convertRequest",
      "args": [
        {
          "baseUrl": "https://upstream.example.invalid",
          "config": {}
        },
        {
          "model": "example-text",
          "stream": false,
          "body": {
            "messages": [
              {
                "role": "user",
                "content": "Hello"
              }
            ]
          }
        }
      ],
      "expected": {
        "body": {
          "deployment": "example-text",
          "messages": [
            {
              "role": "user",
              "content": "Hello"
            }
          ]
        },
        "state": {
          "model": "example-text"
        }
      }
    },
    {
      "name": "rejects unsupported streaming",
      "hook": "convertRequest",
      "args": [
        {},
        {
          "model": "example-text",
          "stream": true,
          "body": {}
        }
      ],
      "expectedError": "non-streaming"
    },
    {
      "name": "retains an actual upstream rejection",
      "hook": "convertResponse",
      "args": [
        {
          "state": {
            "model": "example-text"
          }
        },
        {
          "status": 429,
          "body": "{}"
        }
      ],
      "expected": {
        "error": {
          "status": 429,
          "message": "Upstream request failed",
          "type": "upstream_error"
        }
      }
    },
    {
      "name": "reports successful content and observed token counts",
      "hook": "convertResponse",
      "args": [
        {
          "state": {
            "model": "example-text"
          }
        },
        {
          "status": 200,
          "body": "{\"id\": \"fixture-response\", \"text\": \"Hello\", \"input_tokens\": 10, \"output_tokens\": 2}"
        }
      ],
      "expected": {
        "body": {
          "id": "fixture-response",
          "created": 1805587200,
          "object": "chat.completion",
          "model": "example-text",
          "choices": [
            {
              "index": 0,
              "message": {
                "role": "assistant",
                "content": "Hello"
              },
              "finish_reason": "stop"
            }
          ],
          "usage": {
            "prompt_tokens": 10,
            "completion_tokens": 2,
            "total_tokens": 12
          }
        }
      }
    }
  ]
}
