{
  "compilerOptions": {
    "target":"ES2020", "module":"ESNext", "moduleResolution":"bundler", "lib":["ES2020","DOM","DOM.Iterable"],
    "strict":true, "skipLibCheck":true, "noEmit":true, "noUnusedLocals":true, "noUnusedParameters":true, "types":["vite/client"]
  },
  "include":["src/**/*.ts","src/**/*.vue"],
  "exclude":["src/**/*.spec.ts"]
}
