    },
    {
      "name": "buildContentRequest allows complete video download",
      "hook": "buildContentRequest",
      "args": [
        {
          "baseUrl": "https://upstream.example.invalid",
          "apiKey": "fixture-only",
          "upstreamTaskId": "off5-job-1",
          "artifactKey": "video",
          "clientRequest": { "method": "GET" },
          "data": {
            "code": 0,
            "data": {
              "video_url": "https://cdn.example.invalid/complete.mp4"
            }
          }
        }
      ],
      "expected": {
        "url": "https://upstream.example.invalid/api/v1/video-generations/off5-job-1/content?download=1",
        "method": "GET",
        "headers": {
          "Authorization": "Bearer fixture-only",
          "Content-Type": "application/json"
        }
      }
    },
    {
      "name": "extracts billed CNY final_cost and leaves missing as pending",
      "hook": "extractUsageOnComplete",
      "args": [
        { "state": { "seconds": 6, "resolution": "720p" } },
        { "status": "SUCCESS" },
        { "code": 0, "data": { "billing_status": "billed", "final_cost": "2.5" } }
      ],
      "expected": {
        "seconds": 6,
        "resolution": "720p",
        "billing_pending": false,
        "upstream_cost": {
          "amount": "2.5",
          "currency": "CNY",
          "unit": "upstream_cost",
          "final": true,
          "source": "sub2api_final_cost"
        }
      }
    },
    {
      "name": "leaves missing final_cost on billed task in billing_pending",
      "hook": "extractUsageOnComplete",
      "args": [
        { "state": { "seconds": 6, "resolution": "720p" } },
        { "status": "SUCCESS" },
        { "code": 0, "data": { "billing_status": "billed" } }
      ],
      "expected": { "seconds": 6, "resolution": "720p", "billing_pending": true }
    }
  ]
}
