{
  "unixNow": 1805587200,
  "cases": [
    {
      "name": "decodes cc-seedance text request with standard provider_mode",
      "hook": "protocols",
      "path": ["openai_video", "decodeRequest"],
      "args": [
        {
          "model": "public-official5",
          "upstreamModel": "cc-seedance-2.0-fast",
          "body": {
            "kind": "json",
            "value": {
              "model": "public-official5",
              "prompt": "Lanterns drifting over a river",
              "seconds": "6",
              "size": "1280x720"
            }
          }
        }
      ],
      "expected": {
        "kind": "submit",
        "model": "public-official5",
        "action": "text_to_video",
        "requestBody": {
          "model": "cc-seedance-2.0-fast",
          "prompt": "Lanterns drifting over a river",
          "duration": 6,
          "resolution": "720p",
          "ratio": "16:9",
          "task_mode": "text",
          "content": [],
          "provider_mode": "standard"
        }
      }
    },
    {
      "name": "decodes upstream storage_object_id with client_ref_id selection",
      "hook": "protocols",
      "path": ["openai_video", "decodeRequest"],
      "args": [
        {
          "model": "public-official5",
          "upstreamModel": "cc-seedance-2.0",
          "body": {
            "kind": "json",
            "value": {
              "prompt": "Use [@ref_a] in motion",
              "seconds": 5,
              "metadata": {
                "selected_reference_ids": ["ref_a"],
                "content": [
                  {
                    "type": "image_url",
                    "storage_object_id": "up_obj_001",
                    "client_ref_id": "ref_a"
                  },
                  {
                    "type": "audio_url",
                    "storage_object_id": "up_obj_002",
                    "client_ref_id": "ref_b"
                  }
                ]
              }
            }
          }
        }
      ],
      "expected": {
        "kind": "submit",
        "model": "public-official5",
        "action": "image_to_video",
        "requestBody": {
          "model": "cc-seedance-2.0",
          "prompt": "Use [@ref_a] in motion",
          "duration": 5,
          "resolution": "720p",
          "ratio": "16:9",
          "task_mode": "references",
          "content": [
            {
              "type": "image_url",
              "role": "reference_image",
              "client_ref_id": "ref_a",
              "storage_object_id": "up_obj_001"
            },
            {
              "type": "audio_url",
              "role": "reference_audio",
              "client_ref_id": "ref_b",
              "storage_object_id": "up_obj_002"
            }
          ],
          "provider_mode": "standard",
          "selected_reference_ids": ["ref_a"]
        }
      }
    },
    {
      "name": "decodes multipart bound image and video files with verified reference_durations",
      "hook": "protocols",
      "path": ["openai_video", "decodeRequest"],
      "args": [
        {
          "model": "public-official5",
          "upstreamModel": "cc-seedance-2.0",
          "body": {
            "kind": "multipart",
            "fields": {
              "prompt": ["Blend photo with clip"],
              "seconds": ["5"],
              "metadata": ["{\"reference_durations\":{\"video[]\":[3.25]}}"]
            },
            "files": [
              {
                "ref": "request_file:input_reference",
                "field": "input_reference",
                "filename": "still.png",
                "mimeType": "image/png",
                "size": 1024
              },
              {
                "ref": "request_file:video[]#0",
                "field": "video[]",
                "filename": "motion.mp4",
                "mimeType": "video/mp4",
                "size": 4096
              }
            ]
          }
        }
      ],
      "expected": {
        "kind": "submit",
        "model": "public-official5",
        "action": "image_to_video",
        "requestBody": {
          "model": "cc-seedance-2.0",
          "prompt": "Blend photo with clip",
          "duration": 5,
          "resolution": "720p",
          "ratio": "16:9",
          "task_mode": "references",
          "content": [
            {
              "type": "image_url",
              "role": "reference_image",
              "file_ref": "request_file:input_reference"
            },
            {
              "type": "video_url",
              "role": "reference_video",
              "file_ref": "request_file:video[]#0",
              "duration_seconds": 3.25
            }
          ],
          "provider_mode": "standard"
        }
      }
    },
    {
      "name": "rejects multipart video without metadata.reference_durations",
      "hook": "protocols",
      "path": ["openai_video", "decodeRequest"],
      "args": [
        {
          "model": "public-official5",
          "upstreamModel": "cc-seedance-2.0",
          "body": {
            "kind": "multipart",
            "fields": {
              "prompt": ["Missing duration"]
            },
            "files": [
              {
                "ref": "request_file:video[]#0",
                "field": "video[]",
                "filename": "motion.mp4",
                "mimeType": "video/mp4",
                "size": 2048
              }
            ]
          }
        }
      ],
      "expectedError": "actual duration in metadata.reference_durations"
    },
    {
      "name": "rejects non-cc-seedance model name",
      "hook": "protocols",
      "path": ["openai_video", "decodeRequest"],
      "args": [
        {
          "model": "seedance-2.0",
          "upstreamModel": "seedance-2.0",
          "body": {
            "kind": "json",
            "value": { "prompt": "Ocean" }
          }
        }
      ],
      "expectedError": "Model is not supported"
    },
    {
      "name": "rejects public URL reference",
      "hook": "protocols",
      "path": ["openai_video", "decodeRequest"],
      "args": [
        {
          "model": "public-official5",
          "upstreamModel": "cc-seedance-2.0",
          "body": {
            "kind": "json",
            "value": {
              "prompt": "Ocean",
              "input_reference": "https://cdn.example.invalid/image.png"
            }
          }
        }
      ],
      "expectedError": "Official channel 5 requires storage_object_id"
    },
    {
      "name": "rejects unsupported first_last_frame mode",
      "hook": "protocols",
      "path": ["openai_video", "decodeRequest"],
      "args": [
        {
          "model": "public-official5",
          "upstreamModel": "cc-seedance-2.0",
          "body": {
            "kind": "json",
            "value": {
              "prompt": "Ocean",
              "metadata": {
                "task_mode": "first_last_frame",
                "content": [
                  { "type": "image_url", "storage_object_id": "obj_1" },
                  { "type": "image_url", "storage_object_id": "obj_2" }
                ]
              }
            }
          }
        }
      ],
      "expectedError": "Unsupported task mode"
    },
    {
      "name": "extracts reservation estimates",
      "hook": "extractUsage",
      "args": [
        {
          "requestBody": { "duration": 6, "resolution": "720p" }
        }
      ],
      "expected": { "seconds": 6, "resolution": "720p" }
    },
    {
