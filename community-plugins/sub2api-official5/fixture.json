    {
      "name": "parses submit acceptance",
      "hook": "parseSubmitResponse",
      "args": [
        { "requestBody": { "duration": 6, "resolution": "720p" } },
        { "body": { "code": 0, "data": { "id": "off5-job-1" } } }
      ],
      "expected": {
        "taskId": "off5-job-1",
        "taskData": { "code": 0, "data": { "id": "off5-job-1" } },
        "state": { "seconds": 6, "resolution": "720p" }
      }
    },
    {
      "name": "builds query request",
      "hook": "buildQueryRequest",
      "args": [
        {
          "baseUrl": "https://upstream.example.invalid",
          "apiKey": "fixture-only",
          "taskId": "off5-job-1"
        }
      ],
      "expected": {
        "url": "https://upstream.example.invalid/api/v1/video-generations/off5-job-1",
        "method": "GET",
        "headers": {
          "Authorization": "Bearer fixture-only",
          "Content-Type": "application/json"
        }
      }
    },
    {
      "name": "maps succeeded segment delivery_kind to SUCCESS",
      "hook": "parseTaskResult",
      "args": [
        { "taskId": "off5-job-1", "upstreamModel": "cc-seedance-2.0" },
        {
          "code": 0,
          "data": {
            "id": "off5-job-1",
            "status": "succeeded",
            "delivery_kind": "segment",
            "video_url": "https://cdn.example.invalid/segment.mp4",
            "progress": 100
          }
        }
      ],
      "expected": { "status": "SUCCESS", "progress": "100%" }
    },
    {
      "name": "returns UNKNOWN for unrecognized upstream state",
      "hook": "parseTaskResult",
      "args": [
        { "taskId": "off5-job-1" },
        { "code": 0, "data": { "id": "off5-job-1", "status": "retrying_elsewhere" } }
      ],
      "expected": { "status": "UNKNOWN", "progress": "0%" }
    },
    {
      "name": "render returns final_video_unavailable for segment delivery",
      "hook": "protocols",
      "path": ["openai_video", "render"],
      "args": [
        {},
        {
          "data": {
            "code": 0,
            "data": {
              "delivery_kind": "segment",
              "video_url": "https://cdn.example.invalid/segment.mp4"
            }
          }
        }
      ],
      "expected": {
        "error": {
          "code": "final_video_unavailable",
          "message": "The upstream delivered storyboard segments without a verified complete video. Contact the operator for delivery review."
        }
      }
    },
    {
      "name": "render returns empty patch for verified complete video",
      "hook": "protocols",
      "path": ["openai_video", "render"],
      "args": [
        {},
        {
          "data": {
            "code": 0,
            "data": {
              "video_url": "https://cdn.example.invalid/complete.mp4"
            }
          }
        }
      ],
      "expected": {}
    },
    {
      "name": "listArtifacts returns empty slice for segment delivery",
      "hook": "listArtifacts",
      "args": [
        {
          "status": "SUCCESS",
          "data": {
            "code": 0,
            "data": {
              "delivery_kind": "segment",
              "video_url": "https://cdn.example.invalid/segment.mp4"
            }
          }
        }
      ],
      "expected": []
