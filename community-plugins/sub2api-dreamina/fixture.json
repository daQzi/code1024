{
  "unixNow": 1805587200,
  "cases": [
    {
      "name": "decodes text-to-video request with size mapping",
      "hook": "protocols",
      "path": ["openai_video", "decodeRequest"],
      "args": [
        {
          "model": "public-seedance",
          "upstreamModel": "seedance-2.0",
          "body": {
            "kind": "json",
            "value": {
              "model": "public-seedance",
              "prompt": "Waves under moonlight",
              "seconds": "8",
              "size": "1920x1080"
            }
          }
        }
      ],
      "expected": {
        "kind": "submit",
        "model": "public-seedance",
        "action": "text_to_video",
        "requestBody": {
          "model": "seedance-2.0",
          "prompt": "Waves under moonlight",
          "duration": 8,
          "resolution": "1080p",
          "ratio": "16:9",
          "task_mode": "text"
        }
      }
    },
    {
      "name": "decodes first_frame HTTPS input_reference on seedance-pro-fast",
      "hook": "protocols",
      "path": ["openai_video", "decodeRequest"],
      "args": [
        {
          "model": "fast-vid",
          "upstreamModel": "seedance-pro-fast",
          "body": {
            "kind": "json",
            "value": {
              "prompt": "Zoom in gently",
              "input_reference": "https://cdn.example.invalid/frame1.png"
            }
          }
        }
      ],
      "expected": {
        "kind": "submit",
        "model": "fast-vid",
        "action": "image_to_video",
        "requestBody": {
          "model": "seedance-pro-fast",
          "prompt": "Zoom in gently",
          "duration": 5,
          "resolution": "720p",
          "ratio": "16:9",
          "task_mode": "first_frame",
          "content": [
            {
              "type": "image_url",
              "role": "first_frame",
              "url": "https://cdn.example.invalid/frame1.png"
            }
          ]
        }
      }
    },
    {
      "name": "decodes first_last_frame ordering and dreamina-2.5 draft defaults",
      "hook": "protocols",
      "path": ["openai_video", "decodeRequest"],
      "args": [
        {
          "model": "draft-vid",
          "upstreamModel": "dreamina-seedance-2.5-draft",
          "body": {
            "kind": "json",
            "value": {
              "prompt": "Transition cleanly",
              "duration": 6,
              "metadata": {
                "task_mode": "first_last_frame",
                "ratio": "9:16",
                "content": [
                  {
                    "type": "image_url",
                    "role": "first_frame",
                    "url": "https://cdn.example.invalid/start.png"
                  },
                  {
                    "type": "image_url",
                    "role": "last_frame",
                    "storage_object_id": "obj_end_123"
                  }
                ]
              }
            }
          }
        }
      ],
      "expected": {
        "kind": "submit",
        "model": "draft-vid",
        "action": "image_to_video",
        "requestBody": {
          "model": "dreamina-seedance-2.5-draft",
          "prompt": "Transition cleanly",
          "duration": 6,
          "resolution": "480p",
          "ratio": "9:16",
          "task_mode": "first_last_frame",
          "content": [
            {
              "type": "image_url",
              "role": "first_frame",
              "url": "https://cdn.example.invalid/start.png"
            },
            {
              "type": "image_url",
              "role": "last_frame",
              "storage_object_id": "obj_end_123"
            }
          ]
        }
      }
    },
    {
      "name": "preserves mixed references order on seedance-2.0",
      "hook": "protocols",
      "path": ["openai_video", "decodeRequest"],
      "args": [
        {
          "model": "seedance-2.0",
          "upstreamModel": "seedance-2.0",
          "body": {
            "kind": "json",
            "value": {
              "prompt": "Reference [@Image 1] and [@Audio 1]",
              "seconds": 4,
              "metadata": {
                "task_mode": "references",
                "content": [
                  {
                    "type": "image_url",
                    "role": "reference_image",
                    "url": "https://cdn.example.invalid/ref.png"
                  },
                  {
                    "type": "audio_url",
                    "role": "reference_audio",
                    "storage_object_id": "obj_audio_9"
                  }
                ]
              }
            }
          }
        }
      ],
      "expected": {
        "kind": "submit",
        "model": "seedance-2.0",
        "action": "image_to_video",
        "requestBody": {
          "model": "seedance-2.0",
          "prompt": "Reference [@Image 1] and [@Audio 1]",
          "duration": 4,
          "resolution": "720p",
          "ratio": "16:9",
          "task_mode": "references",
          "content": [
            {
              "type": "image_url",
              "role": "reference_image",
              "url": "https://cdn.example.invalid/ref.png"
            },
            {
              "type": "audio_url",
              "role": "reference_audio",
              "storage_object_id": "obj_audio_9"
            }
          ]
        }
      }
    },
    {
      "name": "rejects unsupported model",
      "hook": "protocols",
      "path": ["openai_video", "decodeRequest"],
      "args": [
        {
          "model": "cc-seedance-2.0",
          "upstreamModel": "cc-seedance-2.0",
          "body": {
            "kind": "json",
            "value": { "prompt": "Ocean" }
          }
        }
      ],
      "expectedError": "Model is not supported"
    },
    {
      "name": "rejects empty prompt",
      "hook": "protocols",
      "path": ["openai_video", "decodeRequest"],
      "args": [
        {
          "model": "seedance-2.0",
          "upstreamModel": "seedance-2.0",
          "body": {
            "kind": "json",
            "value": { "prompt": "   " }
          }
        }
      ],
      "expectedError": "prompt is required"
    },
    {
      "name": "rejects out-of-range duration",
      "hook": "protocols",
      "path": ["openai_video", "decodeRequest"],
      "args": [
        {
          "model": "seedance-2.0",
          "upstreamModel": "seedance-2.0",
          "body": {
            "kind": "json",
            "value": { "prompt": "Ocean", "seconds": 3 }
          }
        }
      ],
      "expectedError": "Unsupported model duration"
    },
    {
      "name": "rejects unsupported resolution on seedance-2.0",
      "hook": "protocols",
      "path": ["openai_video", "decodeRequest"],
      "args": [
        {
          "model": "seedance-2.0",
          "upstreamModel": "seedance-2.0",
          "body": {
            "kind": "json",
            "value": {
              "prompt": "Ocean",
              "seconds": 4,
              "metadata": { "resolution": "480p" }
            }
          }
        }
      ],
      "expectedError": "Unsupported model duration, resolution or ratio"
    },
    {
      "name": "rejects non-HTTPS file URL",
      "hook": "protocols",
      "path": ["openai_video", "decodeRequest"],
      "args": [
        {
          "model": "seedance-2.0",
          "upstreamModel": "seedance-2.0",
          "body": {
            "kind": "json",
            "value": {
              "prompt": "Ocean",
              "metadata": {
                "content": [{ "type": "image_url", "url": "file:///etc/passwd" }]
              }
            }
          }
        }
      ],
      "expectedError": "public HTTPS URL"
    },
    {
      "name": "rejects inline base64 data URL",
      "hook": "protocols",
      "path": ["openai_video", "decodeRequest"],
      "args": [
        {
          "model": "seedance-2.0",
          "upstreamModel": "seedance-2.0",
          "body": {
            "kind": "json",
            "value": {
              "prompt": "Ocean",
              "input_reference": "data:image/png;base64,AAAA"
            }
          }
        }
      ],
      "expectedError": "public HTTPS URL"
    },
    {
      "name": "rejects audio-only references on seedance-2.0",
      "hook": "protocols",
      "path": ["openai_video", "decodeRequest"],
      "args": [
        {
          "model": "seedance-2.0",
          "upstreamModel": "seedance-2.0",
          "body": {
            "kind": "json",
            "value": {
              "prompt": "Music",
              "metadata": {
                "content": [{ "type": "audio_url", "storage_object_id": "aud_only" }]
              }
            }
          }
        }
      ],
      "expectedError": "Audio references require an image or video reference"
    },
    {
      "name": "extracts initial reservation usage",
      "hook": "extractUsage",
      "args": [
        {
          "requestBody": {
            "duration": 8,
            "resolution": "1080p"
          }
        }
      ],
      "expected": {
        "seconds": 8,
        "resolution": "1080p"
      }
    },
    {
      "name": "builds authenticated submit request with X-Request-ID and upstream model",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "baseUrl": "https://upstream.example.invalid/",
          "apiKey": "fixture-only",
          "publicTaskId": "video_1111",
          "upstreamModel": "seedance-2.0",
          "requestBody": {
            "model": "public-seedance",
            "prompt": "Ocean",
            "duration": 8,
            "resolution": "720p",
            "ratio": "16:9",
            "task_mode": "text"
          }
        }
      ],
      "expected": {
        "url": "https://upstream.example.invalid/api/v1/video-generations",
        "method": "POST",
        "headers": {
          "Authorization": "Bearer fixture-only",
          "Content-Type": "application/json",
          "X-Request-ID": "video_1111"
        },
        "body": {
          "model": "seedance-2.0",
          "prompt": "Ocean",
          "duration": 8,
          "resolution": "720p",
          "ratio": "16:9",
          "task_mode": "text"
        }
      }
    },
    {
      "name": "parses valid submit acceptance",
      "hook": "parseSubmitResponse",
      "args": [
        {
          "requestBody": { "duration": 8, "resolution": "720p" }
        },
        {
          "body": { "code": 0, "data": { "id": "upstream-job-42" } }
        }
      ],
      "expected": {
        "taskId": "upstream-job-42",
        "taskData": { "code": 0, "data": { "id": "upstream-job-42" } },
        "state": { "seconds": 8, "resolution": "720p" }
      }
    },
    {
      "name": "rejects submit response missing task identifier",
      "hook": "parseSubmitResponse",
      "args": [
        {
          "requestBody": { "duration": 8, "resolution": "720p" }
        },
        {
          "body": { "code": 0, "data": {} }
        }
      ],
      "expectedError": "Invalid upstream task ID"
    },
    {
      "name": "builds query request",
      "hook": "buildQueryRequest",
      "args": [
        {
          "baseUrl": "https://upstream.example.invalid",
          "apiKey": "fixture-only",
          "taskId": "upstream-job-42"
        }
      ],
      "expected": {
        "url": "https://upstream.example.invalid/api/v1/video-generations/upstream-job-42",
        "method": "GET",
        "headers": {
          "Authorization": "Bearer fixture-only",
          "Content-Type": "application/json"
        }
      }
    },
    {
      "name": "maps queued and unknown states conservatively",
      "hook": "parseTaskResult",
      "args": [
        { "taskId": "upstream-job-42", "upstreamModel": "seedance-2.0" },
        { "code": 0, "data": { "id": "upstream-job-42", "model": "seedance-2.0", "status": "queued", "progress": 10 } }
      ],
      "expected": { "status": "QUEUED", "progress": "10%" }
    },
    {
      "name": "returns UNKNOWN for unrecognized upstream state",
      "hook": "parseTaskResult",
      "args": [
        { "taskId": "upstream-job-42", "upstreamModel": "seedance-2.0" },
        { "code": 0, "data": { "id": "upstream-job-42", "status": "unexpected_future_state" } }
      ],
      "expected": { "status": "UNKNOWN", "progress": "0%" }
    },
    {
      "name": "keeps succeeded without video_url in IN_PROGRESS",
      "hook": "parseTaskResult",
      "args": [
        { "taskId": "upstream-job-42", "upstreamModel": "seedance-2.0" },
        { "code": 0, "data": { "id": "upstream-job-42", "status": "succeeded", "progress": 95 } }
      ],
      "expected": { "status": "IN_PROGRESS", "progress": "95%" }
    },
    {
      "name": "marks SUCCESS when video_url is present",
      "hook": "parseTaskResult",
      "args": [
        { "taskId": "upstream-job-42", "upstreamModel": "seedance-2.0" },
        {
          "code": 0,
          "data": {
            "id": "upstream-job-42",
            "model": "seedance-2.0",
            "status": "succeeded",
            "progress": 100,
            "video_url": "https://storage.example.invalid/v.mp4"
          }
        }
      ],
      "expected": { "status": "SUCCESS", "progress": "100%" }
    },
    {
      "name": "maps cancelled to FAILURE",
      "hook": "parseTaskResult",
      "args": [
        { "taskId": "upstream-job-42" },
        { "code": 0, "data": { "id": "upstream-job-42", "status": "cancelled" } }
      ],
      "expected": { "status": "FAILURE", "progress": "0%" }
    },
    {
      "name": "rejects mismatched task ID in query response",
      "hook": "parseTaskResult",
      "args": [
        { "taskId": "upstream-job-42" },
        { "code": 0, "data": { "id": "other-job", "status": "succeeded" } }
      ],
      "expectedError": "different task ID"
    },
    {
      "name": "rejects mismatched upstream model in query response",
      "hook": "parseTaskResult",
      "args": [
        { "taskId": "upstream-job-42", "upstreamModel": "seedance-2.0" },
        { "code": 0, "data": { "id": "upstream-job-42", "model": "seedance-other", "status": "running" } }
      ],
      "expectedError": "different model"
    },
    {
      "name": "keeps frozen bill in billing_pending even with final_cost 0",
      "hook": "extractUsageOnComplete",
      "args": [
        { "state": { "seconds": 8, "resolution": "720p" } },
        { "status": "SUCCESS" },
        { "code": 0, "data": { "billing_status": "frozen", "final_cost": 0 } }
      ],
      "expected": { "seconds": 8, "resolution": "720p", "billing_pending": true }
    },
    {
      "name": "extracts billed CNY upstream_cost",
      "hook": "extractUsageOnComplete",
      "args": [
        { "state": { "seconds": 8, "resolution": "720p" } },
        { "status": "SUCCESS" },
        { "code": 0, "data": { "billing_status": "billed", "final_cost": "1.25" } }
      ],
      "expected": {
        "seconds": 8,
        "resolution": "720p",
        "billing_pending": false,
        "upstream_cost": {
          "amount": "1.25",
          "currency": "CNY",
          "unit": "upstream_cost",
          "final": true,
          "source": "sub2api_final_cost"
        }
      }
    },
    {
      "name": "accepts explicit zero billed final_cost",
      "hook": "extractUsageOnComplete",
      "args": [
        { "state": { "seconds": 4, "resolution": "720p" } },
        { "status": "SUCCESS" },
        { "code": 0, "data": { "billing_status": "billed", "final_cost": 0, "currency": "USD" } }
      ],
      "expected": {
        "seconds": 4,
        "resolution": "720p",
        "billing_pending": false,
        "upstream_cost": {
          "amount": "0",
          "currency": "USD",
          "unit": "upstream_cost",
          "final": true,
          "source": "sub2api_final_cost"
        }
      }
    },
    {
      "name": "marks null final_cost on billed task as billing_pending",
      "hook": "extractUsageOnComplete",
      "args": [
        { "state": { "seconds": 4, "resolution": "720p" } },
        { "status": "SUCCESS" },
        { "code": 0, "data": { "billing_status": "billed", "final_cost": null } }
      ],
      "expected": { "seconds": 4, "resolution": "720p", "billing_pending": true }
    },
    {
      "name": "marks failure without billing_pending",
      "hook": "extractUsageOnComplete",
      "args": [
        { "state": { "seconds": 4, "resolution": "720p" } },
        { "status": "FAILURE" },
        { "code": 0, "data": { "status": "failed" } }
      ],
      "expected": { "seconds": 4, "resolution": "720p", "billing_pending": false }
    },
    {
      "name": "lists video artifact when ready",
      "hook": "listArtifacts",
      "args": [
        { "status": "SUCCESS", "data": { "code": 0, "data": { "video_url": "https://cdn.example.invalid/v.mp4" } } }
      ],
      "expected": [{ "key": "video", "type": "video" }]
    },
    {
      "name": "builds authenticated HEAD download request",
      "hook": "buildContentRequest",
      "args": [
        {
          "baseUrl": "https://upstream.example.invalid",
          "apiKey": "fixture-only",
          "upstreamTaskId": "upstream-job-42",
          "artifactKey": "video",
          "clientRequest": { "method": "HEAD" },
          "data": { "code": 0, "data": { "video_url": "https://cdn.example.invalid/v.mp4" } }
        }
      ],
      "expected": {
        "url": "https://upstream.example.invalid/api/v1/video-generations/upstream-job-42/content?download=1",
        "method": "HEAD",
        "headers": {
          "Authorization": "Bearer fixture-only",
          "Content-Type": "application/json"
        }
      }
    },
    {
      "name": "rejects download before final video is ready",
      "hook": "buildContentRequest",
      "args": [
        {
          "baseUrl": "https://upstream.example.invalid",
          "apiKey": "fixture-only",
          "upstreamTaskId": "upstream-job-42",
          "artifactKey": "video",
          "clientRequest": { "method": "GET" },
          "data": { "code": 0, "data": {} }
        }
      ],
      "expectedError": "Final video is unavailable"
    }
  ]
}
